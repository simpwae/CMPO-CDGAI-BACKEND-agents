# Primary LLM
ANTHROPIC_API_KEY=
# Fallback LLM
GEMINI_API_KEY=
# Extra fallback: xAI Grok (OpenAI-compatible)
GROK_API_KEY=

# Maryam orchestration mode: "assist" (human-in-the-loop) or "auto" (autonomous)
MARYAM_MODE=assist

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cdgai

# CORS / frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Model overrides (optional)
CLAUDE_MODEL_LEAD=claude-opus-4-8
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
GEMINI_MODEL_LEAD=gemini-2.5-pro
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GROK_MODEL_LEAD=grok-4
GROK_MODEL_DEFAULT=grok-3
